{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vigie",
  "version": "1.1.0",
  "identifier": "io.github.marybaptiste.vigie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VIGIE // STATION SOL",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Baptiste Mary",
    "copyright": "Copyright © 2026 Baptiste Mary. Licence MIT.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/MaryBaptiste/vigie",
    "category": "Education",
    "shortDescription": "Suivi d'objets en orbite et planétarium",
    "longDescription": "Station sol au look TUI rétro : suivi d'objets en orbite (SGP4, données CelesTrak) et planétarium (étoiles, constellations, Soleil, Lune, planètes et comètes).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
